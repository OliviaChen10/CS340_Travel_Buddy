<div class="page">
    <h1>Activities</h1>
    <p class="page-subtitle">Browse activities and manage trip excursions.</p>

    <div class="card">
        <h2>Browse Activities</h2>

        {{!-- Check for empty table --}}
        {{#if activities.length}}
        <table>
            <thead>
                <tr>
                    {{#each activities.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each activities}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Activity}}</td>
                    <td>{{this.Type}}</td>
                    <td>{{this.Trip}}</td>
                    <td>
                        <form method="POST" action="/activities/delete">
                            <input type="hidden" name="activityID" value="{{this.ID}}" />
                            <input type="hidden" name="activityName" value="{{this.Activity}}" />
                            <input type="hidden" name="activityType" value="{{this.Type}}" />
                            <button type="submit"
                                onclick="return confirm('Are you sure you wish to delete this activity?');">
                            Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{!-- Table is empty --}}
        {{else}}
            <p>No activities found.</p>
        {{/if}}
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create an Activity</h2>
            <form class="cuForm" method="POST" action="/activities/create">
                <label for="activityName">Activity Name: </label>
                <input type="text" name="activityName" id="activityName" required />

                <label for="activityType">Activity Type: </label>
                <input type="text" name="activityType" id="activityType" />

                <label for="tripID">Trip: </label>
                <select name="tripID" id="tripID" required>
                    <option value="" disabled selected>Select a Trip</option>
                    {{#each trips}}
                    <option value="{{this.tripID}}">{{this.tripName}}</option>
                    {{/each}}
                </select>

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update an Activity</h2>
            <form class="cuForm" method="POST" action="/activities/update">
                <label for="update_activityID">Activity to Update: </label>
                <select name="activityID" id="update_activityID" required>
                    <option value="" disabled selected>Select an Activity</option>
                    {{#each activities}}
                    <option value="{{this.ID}}">{{this.Activity}}</option>
                    {{/each}}
                </select>

                <label for="update_activityName">Activity Name: </label>
                <input type="text" name="activityName" id="update_activityName" required />

                <label for="update_activityType">Activity Type: </label>
                <input type="text" name="activityType" id="update_activityType" />

                <label for="update_tripID">Trip: </label>
                <select name="tripID" id="update_tripID" required>
                    <option value="" disabled selected>Select a Trip</option>
                    {{#each trips}}
                    <option value="{{this.tripID}}">{{this.tripName}}</option>
                    {{/each}}
                </select>

                <input type="submit" />
            </form>
        </div>
    </div>
</div>

<script>
    const activitiesData = {{{json activities}}};

    document.getElementById('update_activityID').addEventListener('change', function () {
        const activity = activitiesData.find(a => String(a.ID) === this.value);
        if (!activity) return;
        document.getElementById('update_activityName').value = activity.Activity;
        document.getElementById('update_activityType').value = activity.Type;

        const tripSelect = document.getElementById('update_tripID');
        for (const opt of tripSelect.options) {
            if (opt.textContent === activity.Trip) opt.selected = true;
        }
    });
</script>