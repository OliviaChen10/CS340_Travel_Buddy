{{!-- CITATIONS 

    Citation for empty table
    Date retrieved: 8/12/26
    Based on the code provided by Stack Overflow user Duane. Used if table.length code to track table length.
    URL: https://stackoverflow.com/questions/10381827/handlerbars-js-check-if-list-is-empty

    Remaining code is our original work

--}}


<div class="page">
    <h1>Locations</h1>
    <p class="page-subtitle">Browse destination countries supported by the app.</p>

    {{!-- Banner popup when error occurs --}}
    {{#if error}}
    <div class="error-banner">{{error}}</div>
    {{/if}}

    <div class="card">
        <h2>Browse Locations</h2>

        {{!-- Check for empty table --}}
        {{#if locations.length}}
        <table>
            <thead>
                <tr>
                    {{#each locations.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each locations}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Country}}</td>
                    <td>{{this.Continent}}</td>
                    <td>
                        <form method="POST" action="/locations/delete">
                            <input type="hidden" name="locationID" value="{{this.ID}}" />
                            <input type="hidden" name="countryName" value="{{this.Country}}" />
                            <input type="hidden" name="continent" value="{{this.Continent}}" />
                            <button type="submit"
                                onclick="return confirm('Are you sure you wish to delete this location?');">
                                Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{!-- Table is empty --}}
        {{else}}
            <p>No locations found.</p>
        {{/if}}
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Location</h2>
            <form class="cuForm" method="POST" action="/locations/create">
                <label for="countryName">Country: </label>
                <input type="text" name="countryName" id="countryName" required />

                <label for="continent">Continent: </label>
                <input type="text" name="continent" id="continent" required />

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Location</h2>
            <form class="cuForm" method="POST" action="/locations/update">
                <label for="update_locationID">Location to Update: </label>
                <select name="locationID" id="update_locationID" required>
                    <option value="" disabled selected>Select a Location</option>
                    {{#each locations}}
                    <option value="{{this.ID}}">{{this.Country}}</option>
                    {{/each}}
                </select>

                <label for="update_countryName">Country: </label>
                <input type="text" name="countryName" id="update_countryName" required />

                <label for="update_continent">Continent: </label>
                <input type="text" name="continent" id="update_continent" required />

                <input type="submit" />
            </form>
        </div>
    </div>
</div>

<script>
    const locationsData = {{{json locations}}};

    document.getElementById('update_locationID').addEventListener('change', function () {
        const location = locationsData.find(l => String(l.ID) === this.value);
        if (!location) return;
        document.getElementById('update_countryName').value = location.Country;
        document.getElementById('update_continent').value = location.Continent;
    });
</script>