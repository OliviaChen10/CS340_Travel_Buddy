<div class="page">
    <h1>Segments</h1>
    <p class="page-subtitle">Browse transportation legs and manage travel segments.</p>

    <div class="card">
        <h2>Browse Segments</h2>
        <table>
            <thead>
                <tr>
                    {{#each segments.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each segments}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Via}}</td>
                    <td>{{this.Departure}}</td>
                    <td>{{this.DepartureTime}}</td>
                    <td>{{this.Arrival}}</td>
                    <td>{{this.ArrivalTime}}</td>
                    <td>{{this.Trip}}</td>
                    <td>
                        <form method="POST" action="/segments/delete">
                            <input type="hidden" name="segmentID" value="{{this.ID}}" />
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Segment</h2>
            <form class="cuForm" method="POST" action="/segments/create">
                <label for="typeID">Travel Type: </label>
                <select name="typeID" id="typeID" required>
                    <option value="" disabled selected>Select a Type</option>
                    {{#each travelTypes}}
                    <option value="{{this.typeID}}">{{this.travelName}}</option>
                    {{/each}}
                </select>

                <label for="departureLocation">Departure Location: </label>
                <input type="text" name="departureLocation" id="departureLocation" required />

                <label for="departureTime">Departure Time: </label>
                <input type="datetime-local" name="departureTime" id="departureTime" required />

                <label for="arrivalLocation">Arrival Location: </label>
                <input type="text" name="arrivalLocation" id="arrivalLocation" required />

                <label for="arrivalTime">Arrival Time: </label>
                <input type="datetime-local" name="arrivalTime" id="arrivalTime" required />

                <label for="tripID">Trip: </label>
                <select name="tripID" id="tripID" required>
                    <option value="" disabled selected>Select a Trip</option>
                    {{#each trips}}
                    <option value="{{this.tripID}}">{{this.tripName}}</option>
                    {{/each}}
                </select>

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Segment</h2>
            <form class="cuForm" method="POST" action="/segments/update">
                <label for="update_segmentID">Segment to Update: </label>
                <select name="segmentID" id="update_segmentID" required>
                    <option value="" disabled selected>Select a Segment</option>
                    {{#each segments}}
                    <option value="{{this.ID}}">Segment {{this.ID}}</option>
                    {{/each}}
                </select>

                <label for="update_typeID">Travel Type: </label>
                <select name="typeID" id="update_typeID" required>
                    <option value="" disabled selected>Select a Type</option>
                    {{#each travelTypes}}
                    <option value="{{this.typeID}}">{{this.travelName}}</option>
                    {{/each}}
                </select>

                <label for="update_departureLocation">Departure Location: </label>
                <input type="text" name="departureLocation" id="update_departureLocation" required />

                <label for="update_departureTime">Departure Time: </label>
                <input type="datetime-local" name="departureTime" id="update_departureTime" required />

                <label for="update_arrivalLocation">Arrival Location: </label>
                <input type="text" name="arrivalLocation" id="update_arrivalLocation" required />

                <label for="update_arrivalTime">Arrival Time: </label>
                <input type="datetime-local" name="arrivalTime" id="update_arrivalTime" required />

                <label for="update_tripID">Trip: </label>
                <select name="tripID" id="update_tripID" required>
                    <option value="" disabled selected>Select a Trip</option>
                    {{#each trips}}
                    <option value="{{this.tripID}}">{{this.tripName}}</option>
                    {{/each}}
                </select>

                <input type="submit" />
            </form>
        </div>
    </div>
</div>


<script>
    const segmentsData = {{{json segments}}};

    document.getElementById('update_segmentID').addEventListener('change', function () {
        const segment = segmentsData.find(s => String(s.ID) === this.value);
        if (!segment) return;
        document.getElementById('update_departureLocation').value = segment.Departure;
        document.getElementById('update_departureTime').value = segment.DepartureTime.replace(' ', 'T').slice(0, 16);
        document.getElementById('update_arrivalLocation').value = segment.Arrival;
        document.getElementById('update_arrivalTime').value = segment.ArrivalTime.replace(' ', 'T').slice(0, 16);

        const typeSelect = document.getElementById('update_typeID');
        for (const opt of typeSelect.options) {
            if (opt.textContent === segment.Via) opt.selected = true;
        }
        const tripSelect = document.getElementById('update_tripID');
        for (const opt of tripSelect.options) {
            if (opt.textContent === segment.Trip) opt.selected = true;
        }
    });
</script>