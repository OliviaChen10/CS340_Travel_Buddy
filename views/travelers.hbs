<div class="page">
    <h1>Travelers</h1>
    <p class="page-subtitle">Browse travelers and manage their accounts.</p>

    {{#if error}}
    <div class="error-banner">{{error}}</div>
    {{/if}}

    <div class="card">
        <h2>Browse Travelers</h2>

        {{!-- Check for empty table --}}
        {{#if travelers.length}}
        <table>
            <thead>
                <tr>
                    {{#each travelers.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each travelers}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Name}}</td>
                    <td>{{this.Email}}</td>
                    <td>
                        <form method="POST" action="/travelers/delete">
                            <input type="hidden" name="travelerID" value="{{this.ID}}" />
                            <input type="hidden" name="username" value="{{this.Name}}" />
                            <input type="hidden" name="email" value="{{this.Email}}" />
                            <button type="submit" 
                                onclick="return confirm('Are you sure you wish to delete this traveler? This will delete their associated trips.');">
                                Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{!-- Table is empty --}}
        {{else}}
            <p>No travelers found.</p>
        {{/if}}
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Traveler</h2>
            <form class="cuForm" method="POST" action="/travelers/create">
                <label for="username">Username: </label>
                <input type="text" name="username" id="username" required />

                <label for="email">Email: </label>
                <input type="email" name="email" id="email" required />

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Traveler</h2>
            <form class="cuForm" method="POST" action="/travelers/update">
                <label for="update_travelerID">Traveler to Update: </label>
                <select name="travelerID" id="update_travelerID" required>
                    <option value="" disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value="{{this.ID}}">{{this.Name}}</option>
                    {{/each}}
                </select>

                <label for="update_username">Username: </label>
                <input type="text" name="username" id="update_username" required />

                <label for="update_email">Email: </label>
                <input type="email" name="email" id="update_email" required />

                <input type="submit" />
            </form>
        </div>
    </div>
</div>

<script>
    // Embed the travelers data so JS can look up a row by ID without another server call
    const travelersData = {{{json travelers}}};

    document.getElementById('update_travelerID').addEventListener('change', function () {
        const selectedID = this.value;
        const traveler = travelersData.find(t => String(t.ID) === selectedID);
        if (!traveler) return;

        document.getElementById('update_username').value = traveler.Name;
        document.getElementById('update_email').value = traveler.Email;
    });
</script>

