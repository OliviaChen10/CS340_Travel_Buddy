<div class="page">
    <h1>Travelers</h1>
    <p class="page-subtitle">Browse travelers and manage their accounts.</p>

    <div class="card">
        <h2>Browse Travelers</h2>
        <table>
            <thead>
                <tr>
                    {{#each travelers.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each travelers}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Name}}</td>
                    <td>{{this.Email}}</td>
                    <td>
                        <form method="POST" action="/travelers/delete">
                            <input type="hidden" name="travelerID" value="{{this.ID}}" />
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Traveler</h2>
            <form class="cuForm" method="POST" action="/travelers/create">
                <label for="username">Username: </label>
                <input type="text" name="username" id="username" required />

                <label for="email">Email: </label>
                <input type="email" name="email" id="email" required />

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Traveler</h2>
            <form class="cuForm" method="POST" action="/travelers/update">
                <label for="update_travelerID">Traveler to Update: </label>
                <select name="travelerID" id="update_travelerID" required>
                    <option value="" disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value="{{this.ID}}">{{this.Name}}</option>
                    {{/each}}
                </select>

                <label for="update_username">Username: </label>
                <input type="text" name="username" id="update_username" required />

                <label for="update_email">Email: </label>
                <input type="email" name="email" id="update_email" required />

                <input type="submit" />
            </form>
        </div>
    </div>
</div>