<div class="page">
    <h1>Travelers</h1>
    <p class="page-subtitle">Browse travelers and manage their accounts.</p>

    <div class="card">
        <h2>Browse Travelers</h2>
        <table>
            <thead>
                <tr>
                    {{#each travelers.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each travelers}}
                <tr>
                    <td>{{this.travelerID}}</td>
                    <td>{{this.username}}</td>
                    <td>{{this.email}}</td>
                    <form id='delete_traveler_form'>
                        <input type='hidden' name='delete_traveler_id' value='{{this.travelerID}}' />
                        <td><button type='submit'>Delete</button></td>
                    </form>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Traveler</h2>
            <form class='cuForm' id='create_traveler_form' method='POST' action='/travelers/create'>
                <label for='create_traveler_username'>Username: </label>
                <input type='text' name='username' id='create_traveler_username' required />

                <label for='create_traveler_email'>Email: </label>
                <input type='email' name='email' id='create_traveler_email' required />

                <input type='submit' />
            </form>
        </div>

        <div class="card">
            <h2>Update a Traveler</h2>
            <form class='cuForm' id='update_traveler_form'>
                <label for='update_traveler_id'>Traveler to Update: </label>
                <select name='update_traveler_id' id='update_traveler_id' required>
                    <option value='' disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value='{{this.travelerID}}'>{{this.username}}</option>
                    {{/each}}
                </select>

                <label for='update_traveler_username'>Username: </label>
                <input type='text' name='update_traveler_username' id='update_traveler_username' />

                <label for='update_traveler_email'>Email: </label>
                <input type='email' name='update_traveler_email' id='update_traveler_email' />

                <input type='submit' />
            </form>
        </div>
    </div>
</div>
