{{!-- CITATIONS 

    Citation for empty table
    Date retrieved: 8/12/26
    Based on the code provided by Stack Overflow user Duane. Used if table.length code to track table length.
    URL: https://stackoverflow.com/questions/10381827/handlerbars-js-check-if-list-is-empty

    Remaining code is our original work
    
--}}


<div class="page">
    <h1>Travel Types</h1>
    <p class="page-subtitle">Browse and manage the modes of transportation available.</p>

    {{!-- Banner popup when error occurs --}}
    {{#if error}}
    <div class="error-banner">{{error}}</div>
    {{/if}}
    
    <div class="card">
        <h2>Browse Travel Types</h2>

        {{!-- Check for empty table --}}
        {{#if travelTypes.length}}
        <table>
            <thead>
                <tr>
                    {{#each travelTypes.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each travelTypes}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Name}}</td>
                    <td>
                        <form method="POST" action="/traveltypes/delete">
                            <input type="hidden" name="typeID" value="{{this.ID}}" />
                            <input type="hidden" name="travelName" value="{{this.Name}}" />
                            <button type="submit" onclick="return confirm('Are you sure you wish to delete this travel type?');">
                                Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{!-- Table is empty --}}
        {{else}}
            <p>No travel types found.</p>
        {{/if}}
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Travel Type</h2>
            <form class="cuForm" method="POST" action="/traveltypes/create">
                <label for="travelName">Travel Name: </label>
                <input type="text" name="travelName" id="travelName" required />

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Travel Type</h2>
            <form class="cuForm" method="POST" action="/traveltypes/update">
                <label for="update_typeID">Type to Update: </label>
                <select name="typeID" id="update_typeID" required>
                    <option value="" disabled selected>Select a Type</option>
                    {{#each travelTypes}}
                    <option value="{{this.ID}}">{{this.Name}}</option>
                    {{/each}}
                </select>

                <label for="update_travelName">Travel Name: </label>
                <input type="text" name="travelName" id="update_travelName" required />

                <input type="submit" />
            </form>
        </div>
    </div>
</div>

<script>
    const travelTypesData = {{{json travelTypes}}};

    document.getElementById('update_typeID').addEventListener('change', function () {
        const type = travelTypesData.find(t => String(t.ID) === this.value);
        if (!type) return;
        document.getElementById('update_travelName').value = type.Name;
    });
</script>