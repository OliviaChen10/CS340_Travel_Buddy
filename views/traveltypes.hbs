<div class="page">
    <h1>Travel Types</h1>
    <p class="page-subtitle">Browse and manage the modes of transportation available.</p>

    {{#if error}}
    <div class="error-banner">{{error}}</div>
    {{/if}}
    
    <div class="card">
        <h2>Browse Travel Types</h2>
        <table>
            <thead>
                <tr>
                    {{#each travelTypes.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each travelTypes}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Name}}</td>
                    <td>
                        <form method="POST" action="/traveltypes/delete">
                            <input type="hidden" name="typeID" value="{{this.ID}}" />
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Travel Type</h2>
            <form class="cuForm" method="POST" action="/traveltypes/create">
                <label for="travelName">Travel Name: </label>
                <input type="text" name="travelName" id="travelName" required />

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Travel Type</h2>
            <form class="cuForm" method="POST" action="/traveltypes/update">
                <label for="update_typeID">Type to Update: </label>
                <select name="typeID" id="update_typeID" required>
                    <option value="" disabled selected>Select a Type</option>
                    {{#each travelTypes}}
                    <option value="{{this.ID}}">{{this.Name}}</option>
                    {{/each}}
                </select>

                <label for="update_travelName">Travel Name: </label>
                <input type="text" name="travelName" id="update_travelName" required />

                <input type="submit" />
            </form>
        </div>
    </div>
</div>