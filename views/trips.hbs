<div class="page">
    <h1>Trips</h1>
    <p class="page-subtitle">Browse trips and manage travel details.</p>

    {{!-- Banner popup when error occurs --}}
    {{#if error}}
    <div class="error-banner">{{error}}</div>
    {{/if}}

    <div class="card">
        <h2>Browse Trips</h2>

        {{!-- Check for empty table --}}
        {{#if trips.length}}
        <table>
            <thead>
                <tr>
                    {{#each trips.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each trips}}
                <tr>
                    <td>{{this.ID}}</td>
                    <td>{{this.Name}}</td>
                    <td>{{this.Start}}</td>
                    <td>{{this.End}}</td>
                    <td>{{this.Traveler}}</td>
                    <td>{{this.Location}}</td>
                    <td>
                        <form method="POST" action="/trips/delete">
                            <input type="hidden" name="tripID" value="{{this.ID}}" />
                            <input type="hidden" name="tripName" value="{{this.Name}}" />
                            <button type="submit" 
                                onclick="return confirm('Are you sure you wish to delete this trip? This will delete the associated trip segments.')">
                                Delete</button>
                        </form>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{!-- Table is empty --}}
        {{else}}
            <p>No trips found.</p>
        {{/if}}
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Trip</h2>
            <form class="cuForm" method="POST" action="/trips/create">
                <label for="tripName">Trip Name: </label>
                <input type="text" name="tripName" id="tripName" required />

                <label for="startDate">Start Date: </label>
                <input type="date" name="startDate" id="startDate" required />

                <label for="endDate">End Date: </label>
                <input type="date" name="endDate" id="endDate" required />

                <label for="travelerID">Traveler: </label>
                <select name="travelerID" id="travelerID" required>
                    <option value="" disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value="{{this.travelerID}}">{{this.username}}</option>
                    {{/each}}
                </select>

                <label for="locationID">Location: </label>
                <select name="locationID" id="locationID" required>
                    <option value="" disabled selected>Select a Location</option>
                    {{#each locations}}
                    <option value="{{this.locationID}}">{{this.countryName}}</option>
                    {{/each}}
                </select>

                <input type="submit" />
            </form>
        </div>

        <div class="card">
            <h2>Update a Trip</h2>
            <form class="cuForm" method="POST" action="/trips/update">
                <label for="update_tripID">Trip to Update: </label>
                <select name="tripID" id="update_tripID" required>
                    <option value="" disabled selected>Select a Trip</option>
                    {{#each trips}}
                    <option value="{{this.ID}}">{{this.Name}}</option>
                    {{/each}}
                </select>

                <label for="update_tripName">Trip Name: </label>
                <input type="text" name="tripName" id="update_tripName" required />

                <label for="update_startDate">Start Date: </label>
                <input type="date" name="startDate" id="update_startDate" required />

                <label for="update_endDate">End Date: </label>
                <input type="date" name="endDate" id="update_endDate" required />

                <label for="update_travelerID">Traveler: </label>
                <select name="travelerID" id="update_travelerID" required>
                    <option value="" disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value="{{this.travelerID}}">{{this.username}}</option>
                    {{/each}}
                </select>

                <label for="update_locationID">Location: </label>
                <select name="locationID" id="update_locationID" required>
                    <option value="" disabled selected>Select a Location</option>
                    {{#each locations}}
                    <option value="{{this.locationID}}">{{this.countryName}}</option>
                    {{/each}}
                </select>

                <input type="submit" />
            </form>
        </div>
    </div>
</div>

<script>
    const tripsData = {{{json trips}}};

    document.getElementById('update_tripID').addEventListener('change', function () {
        const trip = tripsData.find(t => String(t.ID) === this.value);
        if (!trip) return;
        document.getElementById('update_tripName').value = trip.Name;
        document.getElementById('update_startDate').value = trip.Start.slice(0, 10);
        document.getElementById('update_endDate').value = trip.End.slice(0, 10);
        // Traveler/Location dropdowns need matching by name since 'trips' only has readable names, not IDs
        const travelerSelect = document.getElementById('update_travelerID');
        for (const opt of travelerSelect.options) {
            if (opt.textContent === trip.Traveler) opt.selected = true;
        }
        const locationSelect = document.getElementById('update_locationID');
        for (const opt of locationSelect.options) {
            if (opt.textContent === trip.Location) opt.selected = true;
        }
    });
</script>

