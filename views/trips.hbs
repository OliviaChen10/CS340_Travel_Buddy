<div class="page">
    <h1>Trips</h1>
    <p class="page-subtitle">Browse trips and manage travel details.</p>

    <div class="card">
        <h2>Browse Trips</h2>
        <table>
            <thead>
                <tr>
                    {{#each trips.[0]}}
                    <th>{{@key}}</th>
                    {{/each}}
                    <th></th>
                </tr>
             </thead>
            <tbody>
                {{#each trips}}
                <tr>
                    <td>{{this.tripID}}</td>
                    <td>{{this.startDate}}</td>
                    <td>{{this.endDate}}</td>
                    <td>{{this.travelerID}}</td>
                    <td>{{this.locationID}}</td>
                    <form id='delete_trip_form' method='POST' action='/trips/delete'>
                        <input type='hidden' name='tripID' value='{{this.tripID}}' />
                        <td><button type='submit'>Delete</button></td>
                    </form>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="card-row">
        <div class="card">
            <h2>Create a Trip</h2>
            <form class='cuForm' id='create_trip_form' method='POST' action='/trips/create'>
                <label for='create_trip_startdate'>Start Date: </label>
                <input type='date' name='startDate' id='create_trip_startdate' required />

                <label for='create_trip_enddate'>End Date: </label>
                <input type='date' name='endDate' id='create_trip_enddate' required />

                <label for='create_trip_traveler'>Traveler: </label>
                <select name='travelerID' id='create_trip_traveler' required>
                    <option value='' disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value='{{this.travelerID}}'>{{this.username}}</option>
                    {{/each}}
                </select>

                <label for='create_trip_location'>Location: </label>
                <select name='locationID' id='create_trip_location' required>
                    <option value='' disabled selected>Select a Location</option>
                    {{#each locations}}
                    <option value='{{this.locationID}}'>{{this.countryName}}</option>
                    {{/each}}
                </select>

                <input type='submit' />
            </form>
        </div>

        <div class="card">
            <h2>Update a Trip</h2>
            <form class="cuForm" id="update_trip_form">                
                <label for='update_trip_id'>Trip to Update: </label>
                <select name='update_trip_id' id='update_trip_id' required>
                    <option value='' disabled selected>Select a Trip</option>
                    {{#each trips}}
                    <option value='{{this.tripID}}'>Trip {{this.tripID}}</option>
                    {{/each}}
                </select>

                <label for='update_trip_startdate'>Start Date: </label>
                <input type='date' name='update_trip_startdate' id='update_trip_startdate' />

                <label for='update_trip_enddate'>End Date: </label>
                <input type='date' name='update_trip_enddate' id='update_trip_enddate' />

                <label for='update_trip_traveler'>Traveler: </label>
                <select name='update_trip_traveler' id='update_trip_traveler'>
                    <option value='' disabled selected>Select a Traveler</option>
                    {{#each travelers}}
                    <option value='{{this.travelerID}}'>{{this.username}}</option>
                    {{/each}}
                </select>

                <label for='update_trip_location'>Location: </label>
                <select name='update_trip_location' id='update_trip_location'>
                    <option value='' disabled selected>Select a Location</option>
                    {{#each locations}}
                    <option value='{{this.locationID}}'>{{this.countryName}}</option>
                    {{/each}}
                </select>

                <input type='submit' />
            </form>
        </div>
    </div>
</div>



